<layer-list xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#007E82" android:endColor="#002B35" />
        </shape>
    </item>
    <!-- The artwork covers the entire adaptive mask; extra layer bleed preserves all launcher shapes. -->
    <item>
        <inset android:drawable="@drawable/launcher_artwork" android:insetLeft="3%" android:insetRight="3%" android:insetTop="5%" android:insetBottom="1%" />
    </item>
</layer-list>
